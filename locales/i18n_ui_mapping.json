    },
    {
      "line": 51,
      "tag": "h4",
      "text": "📅 Planting Season",
      "key": "planting_season"
    },
    {
      "line": 52,
      "tag": "p",
      "text": "Kharif: June to August (monsoon crop)",
      "key": "kharif_june_to_august_monsoon_crop"
    },
    {
      "line": 53,
      "tag": "p",
      "text": "Rabi: September to October (winter crop)",
      "key": "rabi_september_to_october_winter_crop"
    },
    {
      "line": 56,
      "tag": "h4",
      "text": "🌾 Variety Selection",
      "key": "variety_selection"
    },
    {
      "line": 60,
      "tag": "h4",
      "text": "🌱 Seed Rate & Preparation",
      "key": "seed_rate_preparation"
    },
    {
      "line": 61,
      "tag": "p",
      "text": "Seed rate: 40-50 kg/hectare for direct sowing",
      "key": "seed_rate_40_50_kg_hectare_for_direct_sowing"
    },
    {
      "line": 62,
      "tag": "p",
      "text": "Soak seeds for 24 hours before sowing",
      "key": "soak_seeds_for_24_hours_before_sowing"
    },
    {
      "line": 63,
      "tag": "p",
      "text": "Treat seeds with Trichoderma for disease prevention",
      "key": "treat_seeds_with_trichoderma_for_disease_prevention"
    },
    {
      "line": 66,
      "tag": "h4",
      "text": "🧂 Soil Requirement",
      "key": "soil_requirement"
    },
    {
      "line": 67,
      "tag": "p",
      "text": "Loamy or clay-loam soil preferred",
      "key": "loamy_or_clay_loam_soil_preferred"
    },
    {
      "line": 68,
      "tag": "p",
      "text": "pH: 6.0-7.5",
      "key": "ph_6_0_7_5"
    },
    {
      "line": 69,
      "tag": "p",
      "text": "Field should be leveled for uniform water distribution",
      "key": "field_should_be_leveled_for_uniform_water_distribution"
    },
    {
      "line": 72,
      "tag": "h4",
      "text": "💧 Water Management",
      "key": "water_management"
    },
    {
      "line": 73,
      "tag": "p",
      "text": "Maintain 5-10 cm standing water during growing season",
      "key": "maintain_5_10_cm_standing_water_during_growing_season"
    },
    {
      "line": 74,
      "tag": "p",
      "text": "Drain 10 days before harvest",
      "key": "drain_10_days_before_harvest"
    },
    {
      "line": 75,
      "tag": "p",
      "text": "Total water requirement: 100-150 cm (with rainfall)",
      "key": "total_water_requirement_100_150_cm_with_rainfall"
    },
    {
      "line": 78,
      "tag": "h4",
      "text": "🌾 Manuring",
      "key": "manuring"
    },
    {
      "line": 79,
      "tag": "p",
      "text": "Farmyard manure: 5-10 tons/hectare",
      "key": "farmyard_manure_5_10_tons_hectare"
    },
    {
      "line": 80,
      "tag": "p",
      "text": "Nitrogen: 60 kg/ha, Phosphorus: 30 kg/ha, Potassium: 30 kg/ha",
      "key": "nitrogen_60_kg_ha_phosphorus_30_kg_ha_potassium_30_kg_ha"
    },
    {
      "line": 84,
      "tag": "h4",
      "text": "🐛 Pest Management",
      "key": "pest_management"
    },
    {
      "line": 85,
      "tag": "p",
      "text": "Stem borer: Spray quinolphos 25 EC (2 ml/L)",
      "key": "stem_borer_spray_quinolphos_25_ec_2_ml_l"
    },
    {
      "line": 86,
      "tag": "p",
      "text": "Leaf folder: Use Bacillus thuringiensis (2 g/L)",
      "key": "leaf_folder_use_bacillus_thuringiensis_2_g_l"
    },
    {
      "line": 87,
      "tag": "p",
      "text": "Gall midge: Spray monocrotophos 36 SL (1 ml/L)",
      "key": "gall_midge_spray_monocrotophos_36_sl_1_ml_l"
    },
    {
      "line": 90,
      "tag": "h4",
      "text": "🦠 Disease Management",
      "key": "disease_management"
    },
    {
      "line": 91,
      "tag": "p",
      "text": "Blast: Spray tricyclazole 75 WP (0.6 g/L) at boot stage",
      "key": "blast_spray_tricyclazole_75_wp_0_6_g_l_at_boot_stage"
    },
    {
      "line": 92,
      "tag": "p",
      "text": "Sheath blight: Use hexaconazole 5 EC (2 ml/L)",
      "key": "sheath_blight_use_hexaconazole_5_ec_2_ml_l"
    },
    {
      "line": 95,
      "tag": "h4",
      "text": "✂️ Harvesting",
      "key": "harvesting"
    },
    {
      "line": 96,
      "tag": "p",
      "text": "Harvest when 80% grains turn golden yellow",
      "key": "harvest_when_80_grains_turn_golden_yellow"
    },
    {
      "line": 97,
      "tag": "p",
      "text": "Crop duration: 120-150 days depending on variety",
      "key": "crop_duration_120_150_days_depending_on_variety"
    },
    {
      "line": 98,
      "tag": "p",
      "text": "Yield: 40-60 quintals/hectare",
      "key": "yield_40_60_quintals_hectare"
    },
    {
      "line": 109,
      "tag": "h3",
      "text": "Tomato Growing Guide",
      "key": "tomato_growing_guide"
    },
    {
      "line": 109,
      "tag": "p",
      "text": "Tap to expand details",
      "key": "tap_to_expand_details"
    },
    {
      "line": 115,
      "tag": "h4",
      "text": "📅 Planting Season",
      "key": "planting_season"
    },
    {
      "line": 116,
      "tag": "p",
      "text": "Summer: December to January (harvest April-June)",
      "key": "summer_december_to_january_harvest_april_june"
    },
    {
      "line": 117,
      "tag": "p",
      "text": "Monsoon: June to July (harvest September-November)",
      "key": "monsoon_june_to_july_harvest_september_november"
    },
    {
      "line": 120,
      "tag": "h4",
      "text": "🌾 Variety Selection",
      "key": "variety_selection"
    },
    {
      "line": 121,
      "tag": "p",
      "text": "For fresh market: Arka Vikas, Arka Meghali, Lakshmi",
      "key": "for_fresh_market_arka_vikas_arka_meghali_lakshmi"
    },
    {
      "line": 122,
      "tag": "p",
      "text": "For processing: Roma, Bhagya, Pusa Ruby",
      "key": "for_processing_roma_bhagya_pusa_ruby"
    },
    {
      "line": 125,
      "tag": "h4",
      "text": "🌱 Nursery & Transplanting",
      "key": "nursery_transplanting"
    },
    {
      "line": 126,
      "tag": "p",
      "text": "Raise nursery for 6-8 weeks (25-30 cm height)",
      "key": "raise_nursery_for_6_8_weeks_25_30_cm_height"
    },
    {
      "line": 128,
      "tag": "p",
      "text": "Transplant 1-2 seedlings per pit",
      "key": "transplant_1_2_seedlings_per_pit"
    },
    {
      "line": 131,
      "tag": "h4",
      "text": "🌍 Soil Requirement",
      "key": "soil_requirement"
    },
    {
      "line": 132,
      "tag": "p",
      "text": "Well-drained loamy soil",
      "key": "well_drained_loamy_soil"
    },
    {
      "line": 133,
      "tag": "p",
      "text": "pH: 6.0-7.0",
      "key": "ph_6_0_7_0"
    },
    {
      "line": 134,
      "tag": "p",
      "text": "Mix 20 tons/ha farmyard manure before planting",
      "key": "mix_20_tons_ha_farmyard_manure_before_planting"
    },
    {
      "line": 137,
      "tag": "h4",
      "text": "💧 Water Management",
      "key": "water_management"
    },
    {
      "line": 138,
      "tag": "p",
      "text": "First irrigation immediately after transplanting",
      "key": "first_irrigation_immediately_after_transplanting"
    },
    {
      "line": 139,
      "tag": "p",
      "text": "Irrigate every 7-10 days during dry season",
      "key": "irrigate_every_7_10_days_during_dry_season"
    },
    {
      "line": 140,
      "tag": "p",
      "text": "Avoid overhead irrigation to prevent fungal diseases",
      "key": "avoid_overhead_irrigation_to_prevent_fungal_diseases"
    },
    {
      "line": 143,
      "tag": "h4",
      "text": "🌾 Staking & Support",
      "key": "staking_support"
    },
    {
      "line": 144,
      "tag": "p",
      "text": "Provide bamboo/wooden stakes or strings for climbing support",
      "key": "provide_bamboo_wooden_stakes_or_strings_for_climbing_support"
    },
    {
      "line": 145,
      "tag": "p",
      "text": "Stake at 30-45 cm height after 3-4 weeks",
      "key": "stake_at_30_45_cm_height_after_3_4_weeks"
    },
    {
      "line": 148,
      "tag": "h4",
      "text": "✂️ Pruning & Thinning",
      "key": "pruning_thinning"
    },
    {
      "line": 149,
      "tag": "p",
      "text": "Remove lower leaves up to first fruit cluster",
      "key": "remove_lower_leaves_up_to_first_fruit_cluster"
    },
    {
      "line": 150,
      "tag": "p",
      "text": "Prune side shoots and maintain 2-3 main stems",
      "key": "prune_side_shoots_and_maintain_2_3_main_stems"
